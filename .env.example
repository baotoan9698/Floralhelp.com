# Neon pooled connection for the application.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-HOST-pooler.neon.tech/neondb?sslmode=require&connection_limit=1"
# Direct (non-pooled) connection for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@YOUR-HOST.neon.tech/neondb?sslmode=require"

# Private Vietnix S3 bucket (required for product photos on Vercel).
# Keep bucket public access blocked. Never use NEXT_PUBLIC_ for credentials.
# S3_ENDPOINT="https://your-s3-endpoint"
# S3_REGION="us-east-1"
# S3_BUCKET="floralhelp-private-images"
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""

# Set only when the admin subdomain is configured; omit for localhost.
# ADMIN_HOST="admin.your-domain.com"
# Public sale website origin for absolute Open Graph image URLs on a VPS.
# SITE_URL="https://sale.your-domain.com"

# Firebase Authentication. Import legacy accounts before enabling in production.
# FIREBASE_AUTH_ENABLED="1"
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_WEB_API_KEY="your-web-api-key"
# GOOGLE_APPLICATION_CREDENTIALS="/etc/floralhelp/firebase-auth.json"
# Never commit the service-account JSON file.
