generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Shop {
  reminderEnabled Boolean @default(false)
  reminderMinutes Int @default(120)
  pushDevices PushDevice[]
  reminders DeliveryReminder[]
  plan String @default("trial")
  accessStatus String @default("pending")
  accessUntil DateTime?
  adminEvents AdminEvent[]
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  customers Customer[]
  orderSequence Int @default(0)
  customerSequence Int @default(0)
  orders       Order[]
  products     Product[]
  cashEntries  CashEntry[]
  sessions     Session[]
}

model Session {
  id        String   @id
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  expiresAt DateTime

  @@index([shopId])
}

model Order {
  id             String   @id @default(cuid())
  shopId         String
  shop           Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  product        String
  productId      String?
  catalogProduct Product? @relation(fields: [productId, shopId], references: [id, shopId], onDelete: NoAction, onUpdate: Cascade)
  code String
  customerId String
  customerRecord Customer @relation(fields: [customerId, shopId], references: [id, shopId], onDelete: NoAction, onUpdate: Cascade)
  customer       String
  phone          String
  address        String
  date           String
  orderDate      String   @default("")
  orderTime      String   @default("")
  source         String   @default("")
  items          OrderItem[]
  history        OrderHistory[]
  time           String
  price          Int
  paidAmount     Int      @default(0)
  shippingFee    Int      @default(0)
  discount       Int      @default(0)
  payments       OrderPayment[]
  status         String   @default("pending")
  note           String   @default("")
  createdAt      DateTime @default(now())

  @@unique([shopId, code])
  @@unique([id, shopId])
  @@index([shopId, customerId])
  @@index([shopId, date])
  @@index([shopId, orderDate])
}

model AuthAttempt {
  key      String   @id
  count    Int      @default(1)
  resetsAt DateTime
}

model OrderHistory {
  id String @id @default(cuid())
  orderId String
  shopId String
  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)
  actorId String
  actorName String
  actorEmail String
  action String
  changes String
  createdAt DateTime @default(now())
  @@index([orderId, shopId, createdAt])
}

model OrderItem {
  id String @id @default(cuid())
  orderId String
  shopId String
  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)
  productId String?
  product Product? @relation(fields: [productId, shopId], references: [id, shopId], onDelete: NoAction)
  name String
  quantity Int
  unitPrice Int
  position Int
  @@index([orderId, shopId])
  @@index([productId, shopId])
}

model OrderPayment {
  id String @id @default(cuid())
  orderId String
  shopId String
  order Order @relation(fields: [orderId, shopId], references: [id, shopId], onDelete: Cascade)
  amount Int
  method String
  position Int
  @@index([orderId, shopId])
}

model Product {
  id          String         @id @default(cuid())
  shopId      String
  shop        Shop           @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name        String
  description String         @default("")
  price       Int
  archived    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  images      ProductImage[]
  orders      Order[]
  orderItems  OrderItem[]

  @@unique([id, shopId])
  @@index([shopId, archived])
}

model ProductImage {
  id            String   @id @default(cuid())
  shopId        String
  productId     String
  product       Product  @relation(fields: [productId, shopId], references: [id, shopId], onDelete: Cascade)
  slot          Int
  storageKey    String   @unique
  storageDriver String
  createdAt     DateTime @default(now())

  @@unique([productId, shopId, slot])
  @@index([shopId])
}

model CashEntry {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  type String
  date String
  title String
  category String
  amount Int
  note String @default("")
  createdAt DateTime @default(now())

  @@index([shopId, date])
}

model Customer {
  id String @id @default(cuid())
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  code String
  name String
  phone String
  address String
  identityKey String
  email String @default("")
  birthday String @default("")
  gender String @default("")
  createdAt DateTime @default(now())
  orders Order[]

  @@unique([id, shopId])
  @@unique([shopId, code])
  @@unique([shopId, identityKey])
}

model Admin {
  id String @id @default(cuid())
  email String @unique
  name String
  passwordHash String
  sessions AdminSession[]
  events AdminEvent[]
}
model AdminSession {
  id String @id
  adminId String
  admin Admin @relation(fields: [adminId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([adminId])
}
model AdminEvent {
  id String @id @default(cuid())
  adminId String
  admin Admin @relation(fields: [adminId], references: [id])
  shopId String
  shop Shop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  details String
  createdAt DateTime @default(now())
  @@index([shopId, createdAt])
}

model PushDevice {
 id String @id @default(cuid())
 shopId String
 shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
 endpoint String @unique
 p256dh String
 auth String
 createdAt DateTime @default(now())
}
model DeliveryReminder {
 id String @id @default(cuid())
 shopId String
 shop Shop @relation(fields:[shopId],references:[id],onDelete:Cascade)
 orderId String
 scheduleKey String @unique
 title String
 body String
 createdAt DateTime @default(now())
 readAt DateTime?
 @@index([shopId,createdAt])
}
